# Deep-merges `cmux.settings` from personal.nix over the cmux.json generated by
# the upstream-tracked home module, so that module stays identical to upstream.
# Its settings are a `let` binding rather than an option, so they cannot be
# merged at evaluation time; instead the generated file is re-rendered with jq.
_:
let
  personal = import ../../../../../personal.nix;
  upstreamCmux = ../../../home/programs/cmux;
in
{
  home-manager.users.${personal.username} =
    { pkgs, lib, ... }:
    let
      upstreamJson = (import upstreamCmux { inherit pkgs lib; }).xdg.configFile."cmux/cmux.json".source;
      overridesJson = (pkgs.formats.json { }).generate "cmux-overrides.json" personal.cmux.settings;
    in
    {
      xdg.configFile."cmux/cmux.json".source = lib.mkForce (
        pkgs.runCommand "cmux.json" { nativeBuildInputs = [ pkgs.jq ]; } ''
          # `*` merges objects recursively, with the right-hand side winning
          jq --slurp '.[0] * .[1]' ${upstreamJson} ${overridesJson} > $out
        ''
      );
    };
}
